<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".profile"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/_30sdp">

        <ImageView
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_32sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/_4sdp"
            app:srcCompat="@drawable/outline_arrow"
            app:tint="#1F41BB" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PROFILE"
            android:gravity="center"
            android:textColor="#1F41BB"
            android:textSize="@dimen/_22sdp"
            android:textStyle="bold"
            android:layout_marginEnd="@dimen/_32sdp"/>

    </LinearLayout>


    <EditText
        android:id="@+id/name_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="50dp"
        android:background="@drawable/custom_background"
        android:hint="Name"
        android:drawableLeft="@drawable/user_svgrepo_com"
        android:drawablePadding="8dp"
        android:inputType="text"
        android:padding="15dp" />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Email"
        android:id="@+id/email_profile"
        android:inputType="textEmailAddress"
        android:layout_marginHorizontal="20dp"
        android:drawableLeft="@drawable/email_svgrepo_com"
        android:drawablePadding="8dp"
        android:padding="15dp"
        android:background="@drawable/custom_background"
        />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Contact"
        android:drawableLeft="@drawable/contact_new_svgrepo_com"
        android:drawablePadding="8dp"
        android:id="@+id/contact_profile"
        android:inputType="phone"
        android:layout_marginHorizontal="20dp"
        android:padding="15dp"
        android:background="@drawable/custom_background"
        />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Password"
        android:id="@+id/password_profile"
        android:drawableLeft="@drawable/lock_svgrepo_com"
        android:drawablePadding="8dp"
        android:inputType="textPassword"
        android:layout_marginHorizontal="20dp"
        android:padding="15dp"
        android:background="@drawable/custom_background"
        />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="Confirm Password"
        android:id="@+id/confirm_password_profile"
        android:drawableLeft="@drawable/lock_svgrepo_com"
        android:drawablePadding="8dp"
        android:inputType="textPassword"
        android:layout_marginHorizontal="20dp"
        android:padding="15dp"
        android:background="@drawable/custom_background"
        android:visibility="gone
"
        />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EDIT PROFILE"
        android:id="@+id/profile_btn"
        android:layout_marginTop="50dp"
        android:layout_marginHorizontal="20dp"
        android:textSize="20dp"
        android:padding="10dp"
        android:background="@drawable/custom_button"
        app:backgroundTint="@null"
        />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="UPDATE PROFILE"
        android:id="@+id/update_profile_btn"
        android:layout_marginTop="50dp"
        android:layout_marginHorizontal="20dp"
        android:textSize="20dp"
        android:padding="10dp"
        android:background="@drawable/custom_button"
        app:backgroundTint="@null"
        android:visibility="gone"
        />

</LinearLayout>